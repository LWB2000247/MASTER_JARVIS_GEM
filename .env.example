# Copy to .env and fill in locally. Never commit the real .env file.

# --- BYOK: bring your own keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Cross-reference engine (core/verifier.js) ---
# Which two providers verifier.crossReference() compares by default.
CROSSREF_LLM_A=openai
CROSSREF_LLM_B=anthropic

# --- n8n dispatcher (core/dispatcher.js) ---
N8N_WEBHOOK_URL=

# --- Vault encryption (core/security.js) ---
# 64 hex chars = 32 bytes, e.g. generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_KEY=

# --- API server (api/server.js) ---
PORT=4000
